---
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import Comments from "../components/articles/Comments.astro";
import ArticleTableOfContents from "../components/articles/ArticleTableOfContents.astro";
import { site } from "../site.config";
interface Heading { depth: number; slug: string; text: string }
interface Props { title: string; description: string; topic: string; date: Date; minutes: number; headings: Heading[] }
const { title, description, topic, date, minutes, headings } = Astro.props;
const formattedDate = date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const canonicalUrl = new URL(Astro.url.pathname, site.url).href;
const shareText = `Read ${title} by ${site.author}`;
const xShare = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(canonicalUrl)}`;
const linkedInShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`;
const emailShare = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`${shareText}\n\n${canonicalUrl}`)}`;
---
<BaseLayout title={`${title} · Aslam Bhai`} description={description} article>
  <div class="reading-progress" data-reading-progress></div>
  <main class="article-page">
    <a class="back-link" href="/"><Icon name="arrowLeft" />Back to articles</a>
    <header class="article-header"><span class="eyebrow">{topic}</span><h1>{title}</h1><p>{description}</p><div class="article-byline"><div class="avatar">TA</div><div class="article-author"><strong>Tanvir Aslam</strong><span>Senior frontend engineer · Technical writer</span></div><span class="byline-meta"><Icon name="clock" />{minutes} min read</span><span class="byline-meta"><Icon name="calendar" />{formattedDate}</span></div></header>
    {headings.length > 0 && <ArticleTableOfContents headings={headings} />}
    <div class="article-reading-area"><aside class="share-tools" aria-label="Article actions"><button class="article-action" data-copy-link data-tooltip="Copy link" aria-label="Copy article link"><Icon name="link" /><span class="sr-only" data-copy-link-label>Copy link</span></button><a class="article-action" href={xShare} data-tooltip="Share on X" target="_blank" rel="noopener noreferrer" aria-label="Share on X (opens in a new tab)"><Icon name="x" /></a><a class="article-action" href={linkedInShare} data-tooltip="Share on LinkedIn" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn (opens in a new tab)"><Icon name="linkedin" /></a><a class="article-action" href={emailShare} data-tooltip="Share by email" aria-label="Share by email"><Icon name="mail" /></a><a class="article-action" href={site.github} data-tooltip="Author on GitHub" target="_blank" rel="noopener noreferrer" aria-label="Author on GitHub (opens in a new tab)"><Icon name="github" /></a></aside><article class="prose"><slot /></article></div>
    <Comments />
    <nav class="article-next"><a href="/"><span>All writing</span>Explore more essays</a><a href="/projects"><span>Next</span>Projects in progress</a></nav>
  </main>
</BaseLayout>
