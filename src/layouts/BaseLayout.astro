---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { site } from "../site.config";
import { darkThemeNames, defaultTheme, themeNames } from "../theme.config";

interface Props { title?: string; description?: string; active?: "home" | "projects" | "about"; article?: boolean }
const { title = site.title, description = site.description, active, article = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = new URL("/brand/social-card.png", site.url);
---
<!doctype html>
<html lang="en" data-theme={defaultTheme === "system" ? "light" : defaultTheme} data-theme-options={themeNames.join(",")} data-dark-themes={darkThemeNames.join(",")}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#18342c" />
    <meta name="codex-preview" content="development" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Aslam Bhai" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aslam Bhai — Engineering, explained from first principles." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script is:inline define:vars={{ defaultTheme, themeNames }}>
      const savedTheme = localStorage.getItem("aslam-theme");
      const systemTheme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      document.documentElement.dataset.theme = themeNames.includes(savedTheme) ? savedTheme : defaultTheme === "system" ? systemTheme : defaultTheme;
    </script>
  </head>
  <body>
    <div class:list={["site-shell", article && "article-site"]}>
      <Header active={active} />
      <slot />
      <Footer />
    </div>
    <script is:inline src="/scripts/site.js"></script>
  </body>
</html>
