---
import StaticPage from "../components/layout/StaticPage.astro";
---

<StaticPage active="about" eyebrow="About" title="Choose how you’d like to explore." intro="Read the profile as a short introduction, or use a terminal-shaped interface to explore it command by command.">
  <section class="about-mode-picker" aria-label="Choose an About page view">
    <a class="about-mode-card" href="/about/read">
      <span class="eyebrow">Reading view</span>
      <h2>Read the profile</h2>
      <p>A concise introduction to Tanvir’s work, interests, and professional links.</p>
      <span class="about-mode-link">Open reading view →</span>
    </a>
    <a class="about-mode-card about-mode-card-terminal" href="/about/terminal">
      <span class="eyebrow">Terminal view</span>
      <h2>Use the terminal</h2>
      <p>Explore the same profile through safe, discoverable commands.</p>
      <span class="about-mode-link">Open terminal view →</span>
    </a>
  </section>
</StaticPage>
