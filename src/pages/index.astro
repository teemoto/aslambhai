---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import DiscoveryRail from "../components/home/DiscoveryRail.astro";
import EditorialLead from "../components/home/EditorialLead.astro";
import EditorialFeed from "../components/home/EditorialFeed.astro";
import HomeAuthorCard from "../components/home/HomeAuthorCard.astro";
import HomeSidebarResources from "../components/home/HomeSidebarResources.astro";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = articles.find(({ data }) => data.featured) ?? articles[0];
const rest = articles.filter(({ id }) => id !== featured.id);
const latest = rest.slice(0, 4);
const leadStoryIds = new Set([featured.id, ...latest.map(({ id }) => id)]);
const entryPointIds = ["building-a-safe-terminal-ui-for-the-web", "working-with-ai-as-a-software-developer", "ad-lifecycle-browser"];
const entryPoints = entryPointIds.flatMap((id) => {
  const article = articles.find((entry) => entry.id === id);
  return article && !leadStoryIds.has(article.id) ? [article] : [];
});
---
<BaseLayout active="home">
  <Fragment slot="head">
    {featured.data.cover?.srcSmall && (
      <link
        rel="preload"
        as="image"
        href={featured.data.cover.srcSmall}
        imagesrcset={`${featured.data.cover.srcSmall} 960w, ${featured.data.cover.src} 1672w`}
        imagesizes="(max-width: 720px) calc(100vw - 36px), (max-width: 1100px) calc(100vw - 60px), 60vw"
        fetchpriority="high"
      />
    )}
  </Fragment>
  <main class="home-grid" id="main-content" tabindex="-1">
    <div class="content-column">
      <EditorialLead featured={featured} latest={latest} />
      <DiscoveryRail articles={articles} />
      <div class="home-content-layout">
        <EditorialFeed articles={articles} curatedIds={[...leadStoryIds]} noScriptIds={latest.map(({ id }) => id)}>
          <HomeAuthorCard slot="mobile-interruption" idPrefix="mobile-home-author" />
        </EditorialFeed>
        <aside class="home-sidebar" aria-label="About the author and recommended links">
          <HomeAuthorCard idPrefix="desktop-home-author" />
          <HomeSidebarResources entryPoints={entryPoints} idPrefix="desktop-home-sidebar" />
        </aside>
        <aside class="mobile-sidebar-resources" aria-label="Recommended articles and projects">
          <HomeSidebarResources entryPoints={entryPoints} idPrefix="mobile-home-sidebar" />
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>
