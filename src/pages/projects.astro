---
import StaticPage from "../components/layout/StaticPage.astro";
import StatusBadge from "../components/projects/StatusBadge.astro";
import Icon from "../components/ui/Icon.astro";
const projects = [
  { name: "Aslam Bhai", state: "Released", desc: "A public technical-writing and project platform for practical essays on frontend architecture, AI, and ad tech.", tags: ["Astro", "Technical writing", "Static site"], href: "https://github.com/teemoto/aslambhai" },
  { name: "Pretend Terminal", state: "Building", desc: "A safe, configurable pseudo-terminal for the web.", tags: ["Terminal UI", "Experiment"], href: "https://github.com/teemoto/pretend-terminal", demo: "https://teemoto.github.io/pretend-terminal/" },
  { name: "JSON Bourne", state: "Building", desc: "A fast, thoughtful workspace for exploring, editing, comparing, and understanding large JSON documents.", tags: ["React", "TypeScript", "Performance"], href: "https://github.com/teemoto/json-bourne" },
  { name: "Sakka", state: "Building", desc: "The publishing system behind Aslam Bhai: designed for low-friction writing, excellent reading, and durable ownership.", tags: ["Content", "SEO", "Astro"], href: "https://github.com/teemoto/Sakka" },
  { name: "Blue Triceratops", state: "Exploring", desc: "A small independent game studio focused on simple, polished mobile games and learning in public.", tags: ["Mobile", "Game design"] },
];
---
<StaticPage active="projects" eyebrow="Work in public" title="Projects" intro="Products and experiments used to turn architectural ideas into working software.">
  <div class="project-grid">{projects.map((project) => project.demo ? <article class="project-card project-card-with-actions"><div class="project-statuses"><StatusBadge status="Released" label="Released v1" /><StatusBadge status="Building" label="Building v2" /></div><h2>{project.name}</h2><p>{project.desc}</p><div class="project-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div><div class="project-card-actions"><a href={project.demo} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.name} demo in a new tab`}>View demo <Icon name="external" size={16} /></a><a href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.name} on GitHub in a new tab`}>Open on GitHub <Icon name="external" size={16} /></a></div></article> : project.href ? <a class="project-card project-card-link" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.name} on GitHub in a new tab`}><StatusBadge status={project.state as "Building" | "Usable alpha" | "Released" | "Exploring"} focusable={false} /><h2>{project.name}</h2><p>{project.desc}</p><div class="project-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div><span class="project-card-link-label">Open on GitHub <Icon name="external" size={16} /></span></a> : <article class="project-card"><StatusBadge status={project.state as "Building" | "Usable alpha" | "Released" | "Exploring"} /><h2>{project.name}</h2><p>{project.desc}</p><div class="project-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div></article>)}</div>
</StaticPage>
