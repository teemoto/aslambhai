---
import StaticPage from "../components/layout/StaticPage.astro";
import StatusBadge from "../components/projects/StatusBadge.astro";
const projects = [
  { name: "JSON Bourne", state: "Building", desc: "A fast, thoughtful workspace for exploring, editing, comparing, and understanding large JSON documents.", tags: ["React", "TypeScript", "Performance"] },
  { name: "Sakka", state: "Building", desc: "The publishing system behind Aslam Bhai: designed for low-friction writing, excellent reading, and durable ownership.", tags: ["Content", "SEO", "Astro"] },
  { name: "Blue Triceratops", state: "Exploring", desc: "A small independent game studio focused on simple, polished mobile games and learning in public.", tags: ["Mobile", "Game design"] },
];
---
<StaticPage active="projects" eyebrow="Work in public" title="Projects" intro="Products and experiments used to turn architectural ideas into working software.">
  <div class="project-grid">{projects.map((project) => <article class="project-card"><StatusBadge status={project.state as "Building" | "Usable alpha" | "Exploring"} /><h2>{project.name}</h2><p>{project.desc}</p><div>{project.tags.map((tag) => <span>{tag}</span>)}</div></article>)}</div>
</StaticPage>
