---
interface Props {
  decorative?: boolean;
  class?: string;
}

const { decorative = true, class: className } = Astro.props;
---

<img
  class:list={["logo-mark", className]}
  src="/brand/tanvir-avatar.png"
  alt={decorative ? "" : "Tanvir Aslam"}
  aria-hidden={decorative ? "true" : undefined}
  width="256"
  height="256"
  loading="eager"
  decoding="async"
/>

<style>
  .logo-mark {
    display: block;
    width: 100%;
    height: 100%;
    flex: 0 0 auto;
    border-radius: 50%;
    object-fit: cover;
  }
</style>
