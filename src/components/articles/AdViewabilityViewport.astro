  <div class="ad-viewability-window">
    <div class="ad-viewability-visible">
      <div class="ad-viewability-ad ad-viewability-ad-one"><span>Ad #1</span><b>Visible</b></div>
      <div class="ad-viewability-article"><strong>Article</strong><i></i><i></i><i></i></div>
    </div>
    <div class="ad-viewability-fold"><span>Viewport edge</span></div>
    <div class="ad-viewability-below">
      <div class="ad-viewability-ellipsis">⋮</div>
