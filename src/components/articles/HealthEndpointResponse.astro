  .health-response__flow > div { display: flex; flex-direction: column; justify-content: center; padding: 1rem .75rem; background: var(--bg); border-top: 2px solid var(--rule); }
  .health-response__flow > div span { color: var(--muted); font-size: .65rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .health-response__flow strong { display: block; margin-top: .4rem; color: var(--ink); font-size: .8rem; line-height: 1.5; }
  .health-response__flow > .health-response__result { border-color: var(--teal); }
  .health-response__result b { color: var(--teal); }
  .health-response__arrow { align-self: center; color: var(--teal); }
