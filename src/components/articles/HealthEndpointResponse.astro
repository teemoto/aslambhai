<figure class="health-response" aria-labelledby="health-response-caption">
  <div class="health-response__flow">
    <div class="health-response__request"><span>Request</span><strong>GET /health</strong></div>
    <span class="health-response__arrow" aria-hidden="true">→</span>
    <div class="health-response__endpoint"><span>Health endpoint</span><strong>Runs its configured checks</strong></div>
    <span class="health-response__arrow" aria-hidden="true">→</span>
    <div class="health-response__result"><span>Response</span><strong><b aria-hidden="true">✓</b> Status: ok</strong></div>
