---
import type { CollectionEntry } from "astro:content";
import ArticleIcon from "./ArticleIcon.astro";

interface Props {
  article: CollectionEntry<"articles">;
  loading?: "eager" | "lazy";
}

const { article, loading = "lazy" } = Astro.props;
const { cover, icon, title, topic } = article.data;
const palette = topic === "AI"
  ? "ai"
  : topic === "Ad Tech"
    ? "ad-tech"
    : topic === "Leadership"
      ? "leadership"
      : topic === "TIL" || topic === "WTF"
        ? "series"
        : "frontend";
---

{cover ? (
  <img
    class="article-cover-image"
    src={cover.src}
    alt={cover.alt}
    width="1672"
    height="941"
    loading={loading}
    decoding="async"
  />
) : (
  <div class:list={["article-cover-fallback", `article-cover-${palette}`]} aria-hidden="true">
    <span class="article-cover-topic">{topic}</span>
    <span class="article-cover-icon"><ArticleIcon kind={icon} size={30} /></span>
    <strong>{title}</strong>
    <span class="article-cover-rule"></span>
  </div>
)}

<style>
  .article-cover-image,
  .article-cover-fallback {
    display: block;
    width: 100%;
    height: 100%;
  }

  .article-cover-image {
    object-fit: cover;
  }

  .article-cover-fallback {
    --cover-accent: var(--teal);
    position: relative;
    overflow: hidden;
    padding: clamp(24px, 4vw, 46px);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--cover-accent) 18%, var(--surface)), var(--surface) 62%),
      var(--surface);
    color: var(--ink);
  }

  .article-cover-fallback::before,
  .article-cover-fallback::after {
    content: "";
    position: absolute;
    border: 1px solid color-mix(in srgb, var(--cover-accent) 42%, transparent);
    border-radius: 50%;
  }

  .article-cover-fallback::before {
    width: 54%;
    aspect-ratio: 1;
    right: -12%;
    top: -30%;
  }

  .article-cover-fallback::after {
    width: 38%;
    aspect-ratio: 1;
    right: 4%;
    top: -20%;
  }

  .article-cover-ai { --cover-accent: #7a63b8; }
  .article-cover-ad-tech { --cover-accent: var(--clay); }
  .article-cover-leadership { --cover-accent: #a47a2b; }
  .article-cover-series { --cover-accent: #557a9c; }

  .article-cover-topic {
    position: relative;
    z-index: 1;
    display: block;
    color: var(--cover-accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .article-cover-icon {
    position: absolute;
    z-index: 1;
    top: clamp(22px, 3vw, 38px);
    right: clamp(22px, 3vw, 38px);
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--cover-accent) 54%, var(--rule));
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    color: var(--cover-accent);
  }

  .article-cover-fallback strong {
    position: absolute;
    z-index: 1;
    right: clamp(24px, 4vw, 46px);
    bottom: clamp(28px, 4vw, 46px);
    left: clamp(24px, 4vw, 46px);
    max-width: 82%;
    font-family: "Source Serif 4", serif;
    font-size: clamp(25px, 3.1vw, 43px);
    font-weight: 500;
    letter-spacing: -.035em;
    line-height: 1.04;
  }

  .article-cover-rule {
    position: absolute;
    right: 0;
    bottom: 18px;
    left: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--cover-accent) 28%, color-mix(in srgb, var(--cover-accent) 18%, transparent) 28%);
  }

  @media (max-width: 720px) {
    .article-cover-icon {
      width: 44px;
      height: 44px;
    }

    .article-cover-fallback strong {
      max-width: 88%;
      font-size: clamp(24px, 7vw, 34px);
    }
  }
</style>
