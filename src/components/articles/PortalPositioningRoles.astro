<figure class="portal-positioning-roles" aria-labelledby="portal-positioning-roles-caption">
  <div class="portal-positioning-roles__roles">
    <section class="portal-positioning-roles__role">
      <header><span class="eyebrow">Positioning system</span><strong>Where should it sit?</strong></header>
      <ul>
        <li><code>Measure</code><span>the trigger and viewport</span></li>
        <li><code>Calculate</code><span><code>x</code>, <code>y</code>, and placement</span></li>
        <li><code>Adjust</code><span>for flip, shift, and collision</span></li>
      </ul>
