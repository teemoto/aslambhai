---
const productionSignals = ["Canaries", "Metrics", "Logs", "Tracing", "RUM"];
---

<figure class="reliability-stack" aria-labelledby="reliability-stack-caption">
  <div class="reliability-stack__testing">
    <div class="reliability-stack__label">Development and CI · verification</div>
    <div class="reliability-stack__pyramid" aria-label="Test pyramid with many unit tests, some integration tests, and few end-to-end tests">
      <div class="reliability-stack__e2e"><strong>Few E2E tests</strong><span>Whole workflows</span></div>
      <div class="reliability-stack__integration"><strong>Some integration tests</strong><span>System boundaries</span></div>
      <div class="reliability-stack__unit"><strong>Many unit tests</strong><span>Focused behavior</span></div>
    </div>
  </div>
  <div class="reliability-stack__boundary"><span>Deploy</span></div>
  <div class="reliability-stack__production">
    <div class="reliability-stack__label">Production · observability</div>
    <ul>{productionSignals.map((signal, index) => <li class:list={{ "reliability-stack__primary": index === 0 }}><span aria-hidden="true">{index === 0 ? "↻" : "·"}</span><strong>{signal}</strong></li>)}</ul>
  </div>
  <figcaption id="reliability-stack-caption">Canaries do not form another layer in the test pyramid. They join the signals that observe the deployed system.</figcaption>
</figure>

<style>
  .reliability-stack { display:grid;grid-template-columns:minmax(0,1fr) 5rem minmax(0,1fr);gap:1.25rem;margin:2rem 0;padding:1.5rem;border:1px solid var(--rule);background:var(--surface);font-family:"Manrope",sans-serif; }
  .reliability-stack__label { margin-bottom:1rem;color:var(--muted);font-size:.67rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase; }
  .reliability-stack__pyramid { display:grid;justify-items:center;gap:.5rem; }
  .reliability-stack__pyramid>div { padding:.75rem 1rem;border-top:2px solid var(--teal);background:var(--bg);text-align:center; }
  .reliability-stack__e2e { width:48%; }.reliability-stack__integration { width:72%; }.reliability-stack__unit { width:100%; }
  .reliability-stack__pyramid strong,.reliability-stack__pyramid span { display:block; }
  .reliability-stack__pyramid strong { color:var(--ink);font-size:.76rem; }.reliability-stack__pyramid span { margin-top:.2rem;color:var(--muted);font-size:.62rem; }
  .reliability-stack__boundary { display:grid;place-items:center;border-right:1px dashed var(--rule);border-left:1px dashed var(--rule); }
  .reliability-stack__boundary span { padding:.45rem .3rem;background:var(--surface);color:var(--clay);font-size:.65rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;writing-mode:vertical-rl; }
  .reliability-stack__production ul { display:grid;gap:.55rem;margin:0;padding:0;list-style:none; }
  .reliability-stack__production li { display:flex;align-items:center;gap:.7rem;margin:0;padding:.68rem .8rem;border-left:2px solid var(--rule);background:var(--bg); }
  .reliability-stack__production li span { color:var(--muted); }.reliability-stack__production li strong { color:var(--ink);font-size:.75rem; }
  .reliability-stack__production .reliability-stack__primary { border-color:var(--teal);background:color-mix(in srgb,var(--teal) 7%,var(--bg)); }
  .reliability-stack__production .reliability-stack__primary span { color:var(--teal);font-size:1rem; }
  .reliability-stack figcaption { grid-column:1 / -1;color:var(--muted);font-size:.75rem;line-height:1.55; }
  @media (max-width:640px) { .reliability-stack { grid-template-columns:1fr;padding:1rem; }.reliability-stack__boundary { min-height:3rem;border:0;border-top:1px dashed var(--rule);border-bottom:1px dashed var(--rule); }.reliability-stack__boundary span { writing-mode:horizontal-tb; }.reliability-stack figcaption { grid-column:1; } }
</style>
