<figure class="portal-trees" aria-labelledby="portal-trees-caption">
  <div class="portal-trees__columns">
    <section class="portal-trees__tree" aria-label="React tree">
      <header><span class="eyebrow">React tree</span><strong>Ownership, state, and events</strong></header>
      <div class="portal-trees__branch">
        <div class="portal-trees__node"><code>App</code><span>renders</span></div>
        <i class="portal-trees__connector" aria-hidden="true"></i>
        <div class="portal-trees__node portal-trees__node--portal"><code>Modal</code><span>still belongs to App</span></div>
      </div>
    </section>

    <section class="portal-trees__tree portal-trees__tree--dom" aria-label="DOM tree">
      <header><span class="eyebrow">DOM tree</span><strong>Physical browser placement</strong></header>
      <div class="portal-trees__branch">
        <div class="portal-trees__node"><code>&lt;body&gt;</code></div>
        <i class="portal-trees__split" aria-hidden="true"></i>
        <div class="portal-trees__children">
          <div class="portal-trees__node"><code>#root</code><span>main app</span></div>
          <div class="portal-trees__node portal-trees__node--target"><code>#modal-root</code><span>portal target</span></div>
        </div>
        <i class="portal-trees__connector portal-trees__connector--target" aria-hidden="true"></i>
        <div class="portal-trees__node portal-trees__node--modal"><code>&lt;Modal /&gt;</code><span>rendered here</span></div>
      </div>
    </section>
  </div>
  <div class="portal-trees__note"><code>createPortal()</code> keeps <code>Modal</code> in the React tree while placing its DOM output in <code>#modal-root</code>.</div>
  <figcaption id="portal-trees-caption">A portal changes DOM placement, not the React relationships that determine state, context, and event propagation.</figcaption>
</figure>

<style>
  .portal-trees { margin:38px 0 44px;font-family:"Manrope",sans-serif; }
  .portal-trees__columns { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px; }
  .portal-trees__tree { min-width:0;padding:20px;border:1px solid var(--rule);background:color-mix(in srgb,var(--surface) 55%,transparent); }
  .portal-trees__tree--dom { border-color:var(--teal);background:color-mix(in srgb,var(--teal) 7%,var(--surface)); }
  .portal-trees__tree header { min-height:48px; }
  .portal-trees__tree .eyebrow { color:var(--teal);font-size:10px; }
  .portal-trees__tree strong { display:block;margin-top:7px;color:var(--ink);font-family:"Source Serif 4",serif;font-size:20px;font-weight:600;line-height:1.1; }
  .portal-trees__branch { display:flex;flex-direction:column;align-items:flex-start;margin-top:22px; }
  .portal-trees__node { display:grid;gap:4px;min-width:120px;padding:11px 13px;border:1px solid var(--rule);background:var(--bg); }
  .portal-trees__node code,.portal-trees__note code { color:var(--ink);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:12px;font-weight:700; }
  .portal-trees__node span { color:var(--muted);font-size:10px;line-height:1.35; }
  .portal-trees__node--portal,.portal-trees__node--target,.portal-trees__node--modal { border-color:var(--teal); }
  .portal-trees__node--portal,.portal-trees__node--target { background:color-mix(in srgb,var(--teal) 8%,var(--bg)); }
  .portal-trees__connector { width:0;height:24px;margin-left:28px;border-left:1px solid var(--teal); }
  .portal-trees__connector::after { content:"";display:block;width:6px;height:6px;border-right:1px solid var(--teal);border-bottom:1px solid var(--teal);transform:translate(-4px,17px) rotate(45deg); }
  .portal-trees__split { width:88px;height:24px;margin-left:28px;border-bottom:1px solid var(--rule);border-left:1px solid var(--rule); }
  .portal-trees__children { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;width:100%; }
  .portal-trees__connector--target { align-self:flex-end;margin-right:34px; }
  .portal-trees__node--modal { align-self:flex-end;background:var(--surface);box-shadow:0 10px 18px color-mix(in srgb,var(--ink) 14%,transparent); }
  .portal-trees__note { margin-top:14px;padding:13px 16px;border-left:3px solid var(--clay);background:color-mix(in srgb,var(--surface) 60%,transparent);color:var(--body);font-size:12px;line-height:1.5; }
  .portal-trees__note code { font-size:.95em; }
  figcaption { margin-top:10px;color:var(--muted);font-size:12px;line-height:1.5;text-align:center; }
  @media (max-width:620px) { .portal-trees__columns { grid-template-columns:1fr; }.portal-trees__tree header { min-height:0; } }
</style>
