---
interface Props {
  columns: string[];
  rows: string[][];
}

const { columns, rows } = Astro.props;
---

<div class="comparison-table">
  <table>
    <thead>
      <tr>{columns.map((column) => <th scope="col">{column}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((row) => <tr>{row.map((cell, index) => index === 0 ? <th scope="row" data-label={columns[index]}>{cell}</th> : <td data-label={columns[index]}>{cell}</td>)}</tr>)}
    </tbody>
  </table>
</div>
