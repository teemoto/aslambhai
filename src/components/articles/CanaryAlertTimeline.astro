---
const runs = [
  { time: "2:00", state: "Failure", failed: true },
  { time: "2:05", state: "Success", failed: false },
  { time: "2:10", state: "Failure", failed: true },
];
---

<figure class="alert-timeline" aria-labelledby="alert-timeline-caption">
  <div class="alert-timeline__label">A flaky signal never becomes trustworthy</div>
  <ol>
    {runs.map(({ time, state, failed }) => <li class:list={{ "alert-timeline__failed": failed }}><time>{time} AM</time><span aria-hidden="true">{failed ? "×" : "✓"}</span><strong>{state}</strong></li>)}
  </ol>
  <div class="alert-timeline__lesson"><span>What the team learns</span><strong>“Ignore that alert.”</strong></div>
  <figcaption id="alert-timeline-caption">Intermittent failures train engineers to distrust the monitor before a real outage arrives.</figcaption>
</figure>

<style>
  .alert-timeline { margin:2rem 0;padding:1.5rem;border:1px solid var(--rule);background:var(--surface);font-family:"Manrope",sans-serif; }
  .alert-timeline__label { color:var(--muted);font-size:.68rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase; }
  .alert-timeline ol { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin:1.25rem 0;padding:0;list-style:none; }
  .alert-timeline li { display:grid;grid-template-columns:1fr auto;gap:.35rem;margin:0;padding:1rem;border-top:3px solid var(--teal);background:var(--bg); }
  .alert-timeline li time { color:var(--muted);font-size:.7rem;font-variant-numeric:tabular-nums; }
  .alert-timeline li>span { grid-row:1 / 3;grid-column:2;align-self:center;color:var(--teal);font-size:1.5rem; }
  .alert-timeline li strong { color:var(--ink);font-size:.82rem; }
  .alert-timeline .alert-timeline__failed { border-color:var(--clay); }
  .alert-timeline .alert-timeline__failed>span { color:var(--clay); }
  .alert-timeline__lesson { padding:1rem;border-left:3px solid var(--clay);background:color-mix(in srgb,var(--clay) 7%,var(--bg)); }
  .alert-timeline__lesson span { color:var(--muted);font-size:.67rem;text-transform:uppercase; }
  .alert-timeline__lesson strong { display:block;margin-top:.25rem;color:var(--ink);font-family:"Source Serif 4",serif;font-size:1.15rem; }
  .alert-timeline figcaption { margin-top:1.1rem;color:var(--muted);font-size:.75rem;line-height:1.55; }
  @media (max-width:520px) { .alert-timeline { padding:1rem; }.alert-timeline ol { grid-template-columns:1fr;gap:.65rem; } }
</style>
