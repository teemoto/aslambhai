---
interface Props { status: "Building" | "Usable alpha" | "Released" | "Exploring"; label?: string; focusable?: boolean }

const { status, label = status, focusable = true } = Astro.props;
const descriptions = {
  Building: "In active development and not yet ready for general use.",
  "Usable alpha": "Available to use today, while features and details continue to evolve.",
  Released: "Available to use today.",
  Exploring: "Early research and experimentation; the direction is still being tested.",
};
const tone = status === "Usable alpha" || status === "Released" ? "ready" : status === "Building" ? "building" : "exploring";
---

<span class:list={["status", `status-${tone}`]} data-tooltip={descriptions[status]} tabindex={focusable ? "0" : undefined}>
  <i></i><span>{label}</span><span class="sr-only">: {descriptions[status]}</span>
</span>
