---
import type { CollectionEntry } from "astro:content";
import Icon from "../ui/Icon.astro";

interface Props { entryPoints: CollectionEntry<"articles">[]; idPrefix?: string }
const { entryPoints, idPrefix = "home-sidebar" } = Astro.props;
const projects = [
  { name: "Pretend Terminal", description: "A safe, configurable pseudo-terminal for the web.", href: "https://teemoto.github.io/pretend-terminal/" },
  { name: "IconKit", description: "A local-first generator for reproducible brand asset packs.", href: "https://github.com/teemoto/iconkit" },
];
---

<div class="home-sidebar-resources">
  <section class="home-sidebar-section entry-points-section" aria-labelledby={`${idPrefix}-entry-points-heading`}>
    <span class="eyebrow">From the archive</span>
    <h2 id={`${idPrefix}-entry-points-heading`}>Explore by subject</h2>
    <ul class="entry-point-list">
      {entryPoints.map((article) => (
        <li data-topic={article.data.topic}>
          <a href={`/articles/${article.id}`}>
            <span class="entry-point-icon"><Icon name={article.data.icon} size={16} /></span>
            <span class="entry-point-copy">
              <span>{article.data.topic}</span>
              <strong>{article.data.title}</strong>
            </span>
            <Icon name="arrowRight" size={15} />
          </a>
        </li>
      ))}
    </ul>
  </section>
  <section class="home-sidebar-section" aria-labelledby={`${idPrefix}-building-now-heading`}>
    <span class="eyebrow">In progress</span>
    <h2 id={`${idPrefix}-building-now-heading`}>Building now</h2>
    <ul class="building-list">
      {projects.map((project) => <li><a href={project.href} target="_blank" rel="noopener noreferrer"><span><strong>{project.name}</strong><small>{project.description}</small></span><Icon name="external" size={15} /></a></li>)}
    </ul>
    <a class="all-projects-link" href="/projects/">View all projects <Icon name="arrowRight" size={16} /></a>
  </section>
</div>

<style>
  .home-sidebar-resources { border-top:1px solid var(--rule); }
  .home-sidebar-section { padding:27px 3px 30px;border-bottom:1px solid var(--rule); }
  h2 { margin:6px 0 18px;color:var(--ink);font-family:"Source Serif 4",serif;font-size:25px;font-weight:500;letter-spacing:-.02em; }
  ol,ul { margin:0;padding:0;list-style:none; }
  .entry-points-section { padding-right:0;padding-left:0; }
  .entry-point-list { display:grid;gap:8px; }
  .entry-point-list li { --entry-accent:var(--teal); }
  .entry-point-list li[data-topic="AI"] { --entry-accent:color-mix(in srgb,var(--teal) 52%,#8069c5); }
  .entry-point-list li[data-topic="Ad Tech"] { --entry-accent:var(--clay); }
  .building-list li+li { border-top:1px solid var(--rule); }
  .entry-point-list a { display:grid;grid-template-columns:30px minmax(0,1fr) 15px;align-items:center;gap:10px;min-height:64px;padding:9px 10px;border:1px solid var(--rule);background:color-mix(in srgb,var(--surface) 72%,transparent);transition:border-color .16s ease,background-color .16s ease,transform .16s ease; }
  .entry-point-icon { display:grid;width:30px;height:30px;place-items:center;border:1px solid color-mix(in srgb,var(--entry-accent) 45%,var(--rule));background:color-mix(in srgb,var(--entry-accent) 8%,var(--surface));color:var(--entry-accent); }
  .entry-point-copy { display:grid;gap:3px; }
  .entry-point-copy>span { color:var(--entry-accent);font-size:8px;font-weight:700;letter-spacing:.1em;text-transform:uppercase; }
  .entry-point-list strong,.building-list strong { color:var(--ink);font-family:"Source Serif 4",serif;font-size:14px;font-weight:500;line-height:1.25;transition:color .16s ease; }
  .entry-point-list a>svg { color:var(--entry-accent);transition:transform .16s ease; }
  .building-list a { display:flex;min-height:72px;align-items:center;justify-content:space-between;gap:16px;padding:12px 0; }
  .building-list a>span { display:grid;gap:4px; }
  .building-list small { color:var(--muted);font-size:11px;line-height:1.45; }
  .building-list svg { flex:0 0 auto;color:var(--teal); }
  .entry-point-list a:hover,.entry-point-list a:focus-visible { border-color:color-mix(in srgb,var(--entry-accent) 58%,var(--rule));background:color-mix(in srgb,var(--entry-accent) 6%,var(--surface));transform:translateX(3px); }
  .entry-point-list a:hover strong,.entry-point-list a:focus-visible strong { color:var(--entry-accent); }
  .entry-point-list a:hover>svg,.entry-point-list a:focus-visible>svg { transform:translateX(3px); }
  .building-list a:hover strong,.building-list a:focus-visible strong { color:var(--teal); }
  .all-projects-link { display:inline-flex;min-height:44px;align-items:center;gap:7px;margin-top:12px;color:var(--teal);font-size:12px;font-weight:700; }
  @media(max-width:720px){.home-sidebar-section{padding-right:0;padding-left:0}.entry-point-list{gap:8px}.entry-point-list a{min-height:68px;padding:10px}.entry-point-list strong{font-size:15px}.building-list strong{font-size:18px}.building-list small{font-size:12px}}

  @media(prefers-reduced-motion:reduce){.entry-point-list a,.entry-point-list a>svg{transition:none}.entry-point-list a:hover,.entry-point-list a:focus-visible,.entry-point-list a:hover>svg,.entry-point-list a:focus-visible>svg{transform:none}}
</style>
