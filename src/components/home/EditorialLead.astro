---
import type { CollectionEntry } from "astro:content";
import ArticleCover from "../articles/ArticleCover.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  featured: CollectionEntry<"articles">;
  latest: CollectionEntry<"articles">[];
}

const { featured, latest } = Astro.props;
const stories = [featured, ...latest];
const formatDate = (date: Date) => date.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
---

<section
  class="editorial-lead"
  data-editorial-lead
  aria-label="Featured and latest writing"
>
  <div class="lead-stage">
    {stories.map((article, index) => (
      <article
        class="lead-panel"
        id={`lead-${article.id}`}
        data-lead-panel={article.id}
        hidden={index !== 0}
      >
        <a class="lead-cover" href={`/articles/${article.id}`} aria-label={`Read ${article.data.title}`}>
          <ArticleCover
            article={article}
            loading={index === 0 ? "eager" : "lazy"}
            mode="lead"
            label={index === 0 ? "Featured article" : "Latest article"}
          />
        </a>
      </article>
    ))}
  </div>

  <aside class="latest-writing" aria-labelledby="latest-writing-title">
    <div class="latest-writing-header">
      <span class="eyebrow" id="latest-writing-title">Latest writing</span>
      <button
        class="featured-return"
        type="button"
        data-featured-trigger
        aria-controls={`lead-${featured.id}`}
        hidden
      >
        <Icon name="arrowLeft" size={16} />
        Back to featured
      </button>
    </div>
    <div class="latest-writing-rail" data-scroll-rail>
      <ol data-scroll-viewport>
        {latest.map((article, index) => (
          <li>
            <button
              type="button"
              data-lead-trigger={article.id}
              aria-controls={`lead-${article.id}`}
              aria-pressed="false"
            >
              <span class="latest-index">{String(index + 1).padStart(2, "0")}</span>
              <span class="latest-topic">{article.data.topic}</span>
              <strong>{article.data.title}</strong>
              <time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt)}</time>
            </button>
          </li>
        ))}
      </ol>
    </div>
    <p class="sr-only" aria-live="polite" aria-atomic="true" data-lead-status></p>
  </aside>
</section>

<style>
  .latest-writing-rail { min-width:0; }

  @media(max-width:720px){
    .latest-writing-rail { position:relative; }
    .latest-writing-rail::after {
      position:absolute;
      z-index:2;
      top:0;
      right:0;
      bottom:5px;
      width:34px;
      background:linear-gradient(90deg,transparent,var(--bg) 88%);
      content:"";
      opacity:0;
      pointer-events:none;
      transition:opacity .16s ease;
    }
    .latest-writing-rail[data-scroll-more]::after { opacity:1; }
  }
</style>
